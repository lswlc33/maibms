<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <!-- 检查更新（GitHub Releases，走国内镜像回退）：仅读公开 API，不采集不发送任何数据 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 蓝牙权限：API 31+ 用 BLUETOOTH_SCAN/CONNECT；≤30 用旧权限 + 定位 -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- API ≤30 的扫描要定位：FINE/COARSE 必须一并声明（Android 12+ 的 FINE 申请要求两者齐备）；
         本权限止于 API 30，31+ 走 BLUETOOTH_SCAN 的 neverForLocation，不再声明定位 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- 后台监控（可选功能，默认关闭）：退到后台保持连接与轮询，保护/告警新触发或失联时发通知。
         POST_NOTIFICATIONS 在用户打开开关那一刻才申请（Android 13+） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <application
        android:name=".MaibmsApp"
        android:label="麻衣 BMS"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 后台监控的保活服务：只为「进程别被回收 + 通知栏看得见」而存在，
             BLE 连接与轮询仍在 Application 作用域的仓库里跑。
             connectedDevice 是 Android 14+ 对前台服务类型的硬要求（缺失会抛 MissingForegroundServiceTypeException） -->
        <service
            android:name=".monitor.BmsMonitorService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
